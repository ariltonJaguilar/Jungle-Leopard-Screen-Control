<UserControl x:Class="JungleLeopardPoc.CoverStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/JungleLeopardScreenControl;component/Win11Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Win11Button}">
            <Setter Property="Padding" Value="16,9" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource Win11PrimaryButton}" />
        <Style x:Key="NavigationButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{StaticResource PanelHoverBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentSoftTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StudioSwitch" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="SwitchTrack" Width="38" Height="22" CornerRadius="11"
                                    Background="{StaticResource PanelBorderBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Ellipse x:Name="SwitchThumb" Width="14" Height="14" Margin="3"
                                             HorizontalAlignment="Left" Fill="{StaticResource TextBrush}" />
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchField" TargetType="TextBox" BasedOn="{StaticResource Win11SearchTextBox}" />
        <Style TargetType="ListBox" x:Key="ThemeList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PanelHoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectionBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ThemeItemTemplate">
            <Grid MinHeight="76">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="54" Height="64" Background="{StaticResource CanvasInsetBrush}" CornerRadius="7" BorderBrush="{StaticResource PreviewBorderBrush}" BorderThickness="1">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,4,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Cover Studio" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Crie, organize e aplique temas no painel do Pro Flow 360." Foreground="{StaticResource MutedBrush}" Margin="1,7,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="ImportButton" Content="Importar tema" ToolTip="Importar pacote .ht/.zip ou tema JSON instalado" Style="{StaticResource ActionButton}" Margin="0,0,10,6" Click="ImportClicked" />
                <Button x:Name="CreateButton" Content="Novo tema" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" Click="CreateClicked" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="14" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="2" Margin="0,0,0,14">
                        <ToggleButton x:Name="LibraryTab" Content="Minha biblioteca" Style="{StaticResource NavigationButton}" IsChecked="True" Click="LibraryTabClicked" />
                        <ToggleButton x:Name="CatalogTab" Content="Catálogo online" Style="{StaticResource NavigationButton}" Click="CatalogTabClicked" />
                    </UniformGrid>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <TextBox x:Name="LocalSearch" Style="{StaticResource SearchField}" TextChanged="LocalSearchChanged" ToolTip="Filtrar minha biblioteca" />
                        <Grid x:Name="CatalogSearch" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="CatalogSearchBox" Grid.Row="0" Style="{StaticResource SearchField}" ToolTip="Buscar temas no catálogo oficial" KeyDown="CatalogSearchKeyDown" />
                            <Button x:Name="SearchButton" Grid.Row="0" Grid.Column="1" Content="Buscar" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="14,8" Click="SearchClicked" />
                            <CheckBox x:Name="FullScreenFilter" Grid.Row="1" Grid.ColumnSpan="2" Content="Somente temas para tela cheia" IsChecked="True" Margin="4,8,0,0" Foreground="{StaticResource MutedBrush}" Click="FullScreenFilterClicked" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="LocalList" Style="{StaticResource ThemeList}" ItemTemplate="{StaticResource ThemeItemTemplate}" SelectionChanged="LocalSelectionChanged" />
                        <ListBox x:Name="CatalogList" Style="{StaticResource ThemeList}" ItemTemplate="{StaticResource ThemeItemTemplate}" SelectionChanged="CatalogSelectionChanged" Visibility="Collapsed" />
                        <TextBlock x:Name="LocalEmpty" Text="Sua biblioteca está vazia.&#10;Importe um pacote .ht ou crie um tema." TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="18" />
                        <TextBlock x:Name="CatalogEmpty" Text="Os temas oficiais vão aparecer aqui.&#10;Abra o catálogo para carregar os resultados." TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="18" Visibility="Collapsed" />
                    </Grid>
                    <Grid x:Name="CatalogPager" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="CatalogPreviousButton" Content="Anterior" Style="{StaticResource ActionButton}" Padding="11,7" Click="CatalogPreviousClicked" />
                        <TextBlock x:Name="CatalogPageLabel" Grid.Column="1" Text="Página 1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <Button x:Name="CatalogNextButton" Grid.Column="2" Content="Próxima" Style="{StaticResource ActionButton}" Padding="11,7" Click="CatalogNextClicked" />
                    </Grid>
                    <StackPanel x:Name="CatalogDownloadArea" Grid.Row="4" Margin="0,10,0,0" Visibility="Collapsed">
                        <ProgressBar x:Name="CatalogDownloadProgress" Minimum="0" Maximum="100" Height="6" Visibility="Collapsed" />
                        <TextBlock x:Name="CatalogDownloadStatus" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" Visibility="Collapsed" />
                        <Button x:Name="DownloadButton" Content="Baixar e instalar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="DownloadClicked" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock x:Name="PreviewTitle" Text="Temas" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="PreviewDetails" Text="Importe um .ht, crie um tema ou explore o catálogo online." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource CanvasInsetBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                    <Grid>
                        <Viewbox x:Name="PreviewViewbox" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="PreviewSurface" Width="960" Height="480" Background="#FF000000" BorderBrush="{StaticResource PreviewBorderBrush}" BorderThickness="1">
                                <Image x:Name="PreviewImage" Stretch="Uniform" />
                            </Border>
                        </Viewbox>
                        <StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                            <TextBlock Text="Prévia do tema" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="Selecione um tema na biblioteca ou no catálogo para visualizar o enquadramento do painel." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="OrientationLabel" Text="Painel 960 &#xD7; 480" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,16,8" />
                        <ToggleButton x:Name="FitThemeToScreenToggle" Content="Ajustar tema para tela" Style="{StaticResource StudioSwitch}"
                                      IsChecked="False" ToolTip="Desligado preserva a proporção e usa bordas pretas; ligado preenche o painel."
                                      Margin="0,0,0,8" Click="FitThemeToScreenClicked" />
                    </WrapPanel>
                    <WrapPanel Grid.Row="1" Orientation="Horizontal">
                        <Button x:Name="EditButton" Content="Editar tema" Style="{StaticResource ActionButton}" IsEnabled="False" Margin="0,0,8,6" Click="EditThemeClicked" />
                        <Button x:Name="DuplicateButton" Content="Duplicar" Style="{StaticResource ActionButton}" IsEnabled="False" Margin="0,0,8,6" Click="DuplicateClicked" />
                        <Button x:Name="DeleteButton" Content="Excluir" Style="{StaticResource ActionButton}" IsEnabled="False" Margin="0,0,8,6" Click="DeleteClicked" />
                        <Button x:Name="ApplyButton" Content="Aplicar pr&#xE9;via &#xE0; tela" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,8,6" Click="ApplyClicked" />
                        <Button x:Name="ExportButton" Content="Exportar .ht" Style="{StaticResource ActionButton}" IsEnabled="False" Margin="0,0,0,6" Click="ExportClicked" />
                    </WrapPanel>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Orienta&#xE7;&#xE3;o da tela" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
                    <ComboBox x:Name="RotationSelector" SelectionChanged="ScreenOptionChanged">
                        <ComboBoxItem Content="0&#xB0;" />
                        <ComboBoxItem Content="90&#xB0; hor&#xE1;rio" />
                        <ComboBoxItem Content="180&#xB0;" />
                        <ComboBoxItem Content="270&#xB0; hor&#xE1;rio" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                    <DockPanel Margin="0,0,0,5">
                        <TextBlock Text="Brilho" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="BrightnessText" DockPanel.Dock="Right" Text="100%" Foreground="{StaticResource MutedBrush}" />
                    </DockPanel>
                    <Slider x:Name="BrightnessSelector" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" ValueChanged="ScreenOptionChanged" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="4,13,0,0" Margin="0,18,0,0">
            <TextBlock x:Name="StatusText" Text="Biblioteca local do Studio." Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
