<UserControl x:Class="JungleLeopardPoc.HtThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/JungleLeopardScreenControl;component/Win11Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="EditorButton" TargetType="Button" BasedOn="{StaticResource Win11Button}">
            <Setter Property="Padding" Value="13,8" />
        </Style>
        <Style x:Key="EditorTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style x:Key="InspectorComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MaxHeight" Value="30" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style x:Key="EditorCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder" Width="16" Height="16" CornerRadius="4"
                                    Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1" VerticalAlignment="Center" />
                            <Path x:Name="CheckGlyph" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="{StaticResource AccentTextBrush}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" IsHitTestVisible="False" />
                            <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorColorButton" TargetType="Button" BasedOn="{StaticResource EditorButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource AccentSoftTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelHoverBrush}" />
        </Style>
        <Style x:Key="InspectorTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True"
                                        Orientation="Horizontal" Margin="0,0,0,14"
                                        Panel.ZIndex="1" ClipToBounds="False" />
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InspectorTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="TabContent" ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PanelBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PanelHoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectionBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="EditorHeading" Text="EDITOR DE TEMAS" FontSize="23" FontWeight="SemiBold" />
                <TextBlock x:Name="EditorDescription" Text="Edite e arraste camadas no canvas do tema. A prévia usa os sensores disponíveis neste PC."
                           Foreground="{StaticResource MutedBrush}" Margin="1,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ThemeNameHeader" Text="Nome" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="ThemeNameBox" Style="{StaticResource EditorTextBox}" Width="240" TextChanged="LayerPropertyChanged" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="CAMADAS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="4,3,0,9" />
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="NewLayerType" Grid.Column="0" Height="34" SelectedIndex="0" Padding="7" Margin="0,0,4,0">
                            <ComboBoxItem Content="Texto" Tag="text" />
                            <ComboBoxItem Content="Indicador de dados" Tag="data" />
                            <ComboBoxItem Content="Letra atual" Tag="lyric" />
                            <ComboBoxItem Content="Mídia" Tag="addMedia" />
                            <ComboBoxItem Content="Mídia e letras" Tag="SongDisplay" />
                            <ComboBoxItem Content="Bloco" Tag="block" />
                            <ComboBoxItem Content="Barra de progresso" Tag="progress" />
                            <ComboBoxItem Content="Medidor circular" Tag="arc" />
                            <ComboBoxItem Content="Gráfico de linha" Tag="lineChart" />
                            <ComboBoxItem Content="Espectro de áudio" Tag="audioWave" />
                        </ComboBox>
                        <Button Grid.Column="1" Content="Adicionar" Style="{StaticResource EditorButton}" Padding="7,6" Margin="4,0,0,0" Click="AddLayerClicked" />
                    </Grid>
                    <ListBox x:Name="LayerList" Grid.Row="2" Background="Transparent" BorderThickness="0" AllowDrop="True"
                             SelectionMode="Extended" SelectionChanged="LayerSelectionChanged"
                             PreviewMouseLeftButtonDown="LayerListMouseDown" PreviewMouseMove="LayerListMouseMove"
                             DragOver="LayerListDragOver" Drop="LayerListDrop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{Binding Indent}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="30" /><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource EditorCheckBox}" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanDelete}"
                                              VerticalAlignment="Center" ToolTip="Marcar para excluir em lote" />
                                    <Button Grid.Column="1" Width="26" Height="26" Padding="0" VerticalAlignment="Center"
                                            Style="{StaticResource Win11Button}"
                                            AutomationProperties.Name="{Binding VisibilityTooltip}"
                                            ToolTip="{Binding VisibilityTooltip}" IsEnabled="{Binding CanToggleVisibility}" Click="LayerVisibilityClicked">
                                        <Grid Width="16" Height="16">
                                            <Path x:Name="EyeOutline" Data="M 1,8 C 3.2,4.2 5.5,2.5 8,2.5 C 10.5,2.5 12.8,4.2 15,8 C 12.8,11.8 10.5,13.5 8,13.5 C 5.5,13.5 3.2,11.8 1,8 Z"
                                                  Fill="Transparent" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" />
                                            <Ellipse x:Name="EyePupil" Width="4.5" Height="4.5" Fill="{StaticResource AccentBrush}" />
                                            <Path x:Name="EyeSlash" Data="M 3,3 L 13,13" Stroke="{StaticResource MutedBrush}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="LayerLockButton" Grid.Column="2" Width="26" Height="26" Padding="0" VerticalAlignment="Center"
                                            Style="{StaticResource Win11Button}"
                                            AutomationProperties.Name="{Binding LockTooltip}" ToolTip="{Binding LockTooltip}" Click="LayerLockClicked">
                                        <Canvas Width="16" Height="16">
                                            <Path x:Name="UnlockedShackle" Data="M 4,7 V 5 A 4,4 0 0 1 12,5 V 3"
                                                  Fill="Transparent" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <Path x:Name="LockedShackle" Data="M 4,7 V 5 A 4,4 0 0 1 12,5 V 7"
                                                  Fill="Transparent" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                                            <Border x:Name="LockIconBody" Canvas.Left="3" Canvas.Top="7" Width="10" Height="7" CornerRadius="1.5"
                                                    Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource MutedBrush}" BorderThickness="1" />
                                            <Ellipse x:Name="LockKeyhole" Canvas.Left="7" Canvas.Top="9" Width="2" Height="2" Fill="{StaticResource AccentBrush}" />
                                        </Canvas>
                                    </Button>
                                    <Border Grid.Column="4" Tag="LayerDragHandle" Cursor="SizeAll" ToolTip="Segure e arraste para reordenar"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="22" Background="Transparent">
                                        <TextBlock Text="&#x283F;" FontSize="15" Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                    <Setter TargetName="EyePupil" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="EyeSlash" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                    <Setter TargetName="UnlockedShackle" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="LockedShackle" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="LayerLockButton" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="LayerLockButton" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="LockedShackle" Property="Stroke" Value="{StaticResource AccentTextBrush}" />
                                    <Setter TargetName="LockIconBody" Property="Background" Value="{StaticResource AccentTextBrush}" />
                                    <Setter TargetName="LockIconBody" Property="BorderBrush" Value="{StaticResource AccentTextBrush}" />
                                    <Setter TargetName="LockKeyhole" Property="Fill" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="310" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="CAMADA SELECIONADA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="2,10,0,3" />
                        <Button Grid.Row="1" Content="Duplicar" ToolTip="Criar uma cópia da camada selecionada" Style="{StaticResource EditorButton}" Padding="7,6" FontSize="12" Margin="0,3,3,0" Click="DuplicateLayerClicked" />
                        <Button x:Name="RemoveLayerButton" Grid.Row="1" Grid.Column="1" Content="Excluir" ToolTip="Excluir a camada selecionada" Style="{StaticResource EditorButton}" Padding="7,6" FontSize="12" Margin="3,3,0,0" Click="RemoveLayerClicked" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="AGRUPAMENTO E SELEÇÃO" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="2,10,0,3" />
                        <Button Grid.Row="3" Content="Agrupar" ToolTip="Agrupar as camadas selecionadas" Style="{StaticResource EditorButton}" Padding="7,6" FontSize="12" Margin="0,0,3,3" Click="GroupSelectedLayersClicked" />
                        <Button Grid.Row="3" Grid.Column="1" Content="Desagrupar" ToolTip="Separar as camadas do grupo selecionado" Style="{StaticResource EditorButton}" Padding="7,6" FontSize="12" Margin="3,0,0,3" Click="UngroupSelectedLayerClicked" />
                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="MARCAR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="2,7,0,3" />
                        <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="Todos" ToolTip="Marcar todas as camadas" Style="{StaticResource EditorButton}" Padding="3,6" FontSize="11" Margin="0,0,2,0" Click="CheckAllLayersClicked" />
                            <Button Grid.Column="1" Content="Desmarcar" ToolTip="Desmarcar todas as camadas" Style="{StaticResource EditorButton}" Padding="3,6" FontSize="11" Margin="2,0,2,0" Click="UncheckAllLayersClicked" />
                            <Button Grid.Column="2" Content="Inverter" ToolTip="Inverter a marcação das camadas" Style="{StaticResource EditorButton}" Padding="3,6" FontSize="11" Margin="2,0,0,0" Click="InvertLayerChecksClicked" />
                        </Grid>
                        <Button Grid.Row="6" Grid.ColumnSpan="2" Content="Excluir marcadas" ToolTip="Excluir as camadas marcadas na lista" Style="{StaticResource EditorButton}" Padding="7,6" FontSize="12" Margin="0,3,0,0" Click="RemoveCheckedLayersClicked" />
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource CanvasInsetBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,14,0">
                <Grid>
                    <Viewbox x:Name="PreviewViewbox" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="PreviewSurface" Width="960" Height="480" Background="{StaticResource PreviewBrush}" BorderBrush="{StaticResource PreviewBorderBrush}" BorderThickness="0">
                            <Grid x:Name="PreviewCanvasHost" Width="960" Height="480" ClipToBounds="True">
                                <Image x:Name="PreviewImage" Stretch="Fill" IsHitTestVisible="False" />
                                <Canvas x:Name="EditorOverlay" Width="960" Height="480" Background="Transparent"
                                        MouseLeftButtonDown="EditorOverlayMouseDown" MouseMove="EditorOverlayMouseMove" MouseLeftButtonUp="EditorOverlayMouseUp" />
                            </Grid>
                        </Border>
                    </Viewbox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16">
                <TabControl x:Name="InspectorTabs" Style="{StaticResource InspectorTabControlStyle}"
                            ItemContainerStyle="{StaticResource InspectorTabItemStyle}">
                    <TabControl.Resources>
                        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource InspectorComboBoxStyle}" />
                    </TabControl.Resources>
                    <TabItem x:Name="BackgroundInspectorTab" Header="Fundo">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                            <StackPanel>
                        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="PLANO DE FUNDO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Cor de base" Foreground="{StaticResource MutedBrush}" />
                                <DockPanel Margin="0,4,0,8"><Button DockPanel.Dock="Right" Style="{StaticResource EditorColorButton}" Content="…" ToolTip="Escolher cor" Tag="{Binding ElementName=BackgroundColorBox}" IsEnabled="{Binding ElementName=BackgroundColorBox, Path=IsEnabled}" Click="PickColorClicked" /><TextBox x:Name="BackgroundColorBox" Style="{StaticResource EditorTextBox}" TextChanged="BackgroundColorChanged" /></DockPanel>
                                <TextBlock Text="Segunda cor do gradiente" Foreground="{StaticResource MutedBrush}" />
                                <DockPanel Margin="0,4,0,8"><Button DockPanel.Dock="Right" Style="{StaticResource EditorColorButton}" Content="…" ToolTip="Escolher cor" Tag="{Binding ElementName=BackgroundSecondaryColorBox}" IsEnabled="{Binding ElementName=BackgroundSecondaryColorBox, Path=IsEnabled}" Click="PickColorClicked" /><TextBox x:Name="BackgroundSecondaryColorBox" Style="{StaticResource EditorTextBox}" TextChanged="BackgroundColorChanged" /></DockPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="Enquadramento" Foreground="{StaticResource MutedBrush}" />
                                        <ComboBox x:Name="BackgroundFitBox" Height="32" Margin="0,4,0,0" SelectionChanged="BackgroundFitChanged">
                                            <ComboBoxItem Content="Cobrir" Tag="cover" />
                                            <ComboBoxItem Content="Conter" Tag="contain" />
                                            <ComboBoxItem Content="Esticar" Tag="stretch" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Gradiente" Foreground="{StaticResource MutedBrush}" />
                                        <ComboBox x:Name="BackgroundGradientBox" Height="32" Margin="0,4,0,0" SelectionChanged="BackgroundGradientChanged">
                                            <ComboBoxItem Content="Linear" Tag="linear" />
                                            <ComboBoxItem Content="Circular" Tag="circle" />
                                            <ComboBoxItem Content="Sólido" Tag="solid" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Recorte da mídia de fundo (%)" Foreground="{StaticResource MutedBrush}" />
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,4,5"><TextBlock Text="X" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="BackgroundXBox" Style="{StaticResource EditorTextBox}" TextChanged="BackgroundLayoutChanged" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,5"><TextBlock Text="Y" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="BackgroundYBox" Style="{StaticResource EditorTextBox}" TextChanged="BackgroundLayoutChanged" /></StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,0,4,0"><TextBlock Text="Largura" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="BackgroundWidthBox" Style="{StaticResource EditorTextBox}" TextChanged="BackgroundLayoutChanged" /></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Altura" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="BackgroundHeightBox" Style="{StaticResource EditorTextBox}" TextChanged="BackgroundLayoutChanged" /></StackPanel>
                                </Grid>
                                <Button x:Name="ChooseBackgroundButton" Content="Escolher mídia de fundo…" Style="{StaticResource EditorButton}" Click="ChooseBackgroundClicked" />
                                <Button x:Name="ClearBackgroundButton" Content="Remover mídia de fundo" Style="{StaticResource EditorButton}" Margin="0,6,0,0" Click="ClearBackgroundClicked" />
                            </StackPanel>
                        </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="LayerInspectorTab" Header="Camada" IsEnabled="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                            <StackPanel>
                        <TextBlock Text="CAMADA SELECIONADA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                        <TextBox x:Name="LayerNameBox" Style="{StaticResource EditorTextBox}" Margin="0,4,0,12" TextChanged="LayerPropertyChanged" />
                        <TextBlock x:Name="LayerTypeText" Text="Tipo" Foreground="{StaticResource MutedBrush}" />
                        <StackPanel x:Name="LayerTransformPanel">
                        <Grid Margin="0,8,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,5,8"><TextBlock Text="X" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="XBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,8"><TextBlock Text="Y" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="YBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,5,0"><TextBlock Text="Largura" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="WidthBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Altura" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="HeightBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                        </Grid>
                        <TextBlock x:Name="RotateLabel" Text="Rotação (graus)" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="RotateBox" Style="{StaticResource EditorTextBox}" Margin="0,4,0,12" TextChanged="LayerPropertyChanged" LostKeyboardFocus="LayerRotateLostFocus" />
                        </StackPanel>
                        <StackPanel x:Name="ContentPanel">
                        <TextBlock x:Name="ContentLabel" Text="Texto" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="ContentBox" Style="{StaticResource EditorTextBox}" Margin="0,4,0,12" TextChanged="LayerPropertyChanged" />
                        </StackPanel>
                        <TextBlock x:Name="DataSourceLabel" Text="Fonte de dados" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox x:Name="DataSourceBox" Height="34" Margin="0,4,0,12" IsEditable="False" IsTextSearchEnabled="False" SelectionChanged="DataSourceChanged" LostKeyboardFocus="DataSourceLostFocus" />
                        <Grid x:Name="DataRangePanel" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0"><TextBlock Text="Faixa mínima" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="RangeMinBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Faixa máxima" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="RangeMaxBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                        </Grid>
                        <Border x:Name="GeneralLayerStylePanel" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ESTILO E FORMATAÇÃO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel x:Name="BorderRadiusPanel" Margin="0,0,5,7"><TextBlock Text="Raio do canto (px)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="BorderRadiusBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                                    <StackPanel x:Name="BorderWidthPanel" Grid.Column="1" Margin="5,0,0,7"><TextBlock Text="Contorno (px)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="BorderWidthBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                                    <StackPanel x:Name="StrokeWidthPanel" Grid.Row="1" Margin="0,0,5,7"><TextBlock Text="Espessura do arco" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="StrokeWidthBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                                    <StackPanel x:Name="GapDegreePanel" Grid.Row="1" Grid.Column="1" Margin="5,0,0,7"><TextBlock Text="Abertura do arco (0-295°)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="GapDegreeBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" LostKeyboardFocus="LayerNumericLostFocus" /></StackPanel>
                                    <StackPanel x:Name="PrecisionPanel" Grid.Row="2" Margin="0,0,5,0"><TextBlock Text="Casas decimais (0-3)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="PrecisionBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" LostKeyboardFocus="LayerNumericLostFocus" /></StackPanel>
                                    <StackPanel x:Name="ClockFormatPanel" Grid.Row="2" Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Formato do relógio" Foreground="{StaticResource MutedBrush}" /><ComboBox x:Name="ClockFormatBox" Height="34" IsEditable="True" IsTextSearchEnabled="False" ToolTip="Escolha um formato ou digite um padrão compatível" SelectionChanged="AdvancedSelectionChanged" Loaded="ClockFormatBoxLoaded" LostKeyboardFocus="ClockFormatLostFocus"><ComboBoxItem Content="YYYY/MM/DD HH:mm:ss"/><ComboBoxItem Content="YYYY/MM/DD HH:mm"/><ComboBoxItem Content="YYYY/MM/DD"/><ComboBoxItem Content="YYYY/MM"/><ComboBoxItem Content="MM/DD"/><ComboBoxItem Content="HH:mm:ss"/><ComboBoxItem Content="HH:mm"/><ComboBoxItem Content="mm:ss"/><ComboBoxItem Content="YYYY/MM/DD h:mm:ss A"/><ComboBoxItem Content="YYYY/MM/DD h:mm A"/><ComboBoxItem Content="h:mm:ss A"/><ComboBoxItem Content="h:mm A"/></ComboBox></StackPanel>
                                    <StackPanel x:Name="ProgressTypePanel" Grid.Row="4" Margin="0,7,5,7"><TextBlock Text="Formato da barra" Foreground="{StaticResource MutedBrush}" /><ComboBox x:Name="ProgressTypeBox" Height="34" SelectionChanged="AdvancedSelectionChanged"><ComboBoxItem Content="Linear" Tag="strip"/><ComboBoxItem Content="Circular" Tag="circle"/></ComboBox></StackPanel>
                                    <StackPanel x:Name="BorderBgTypePanel" Grid.Row="4" Grid.Column="1" Margin="5,7,0,7"><TextBlock Text="Preenchimento" Foreground="{StaticResource MutedBrush}" /><ComboBox x:Name="BorderBgTypeBox" Height="34" SelectionChanged="AdvancedSelectionChanged"><ComboBoxItem Content="Gradiente" Tag="normal"/><ComboBoxItem Content="Segmentado" Tag="cut"/><ComboBoxItem Content="Cor única" Tag="single"/></ComboBox></StackPanel>
                                    <StackPanel x:Name="BorderStylePanel" Grid.Row="5" Margin="0,0,5,0"><TextBlock Text="Estilo da borda" Foreground="{StaticResource MutedBrush}" /><ComboBox x:Name="BorderStyleBox" Height="34" SelectionChanged="AdvancedSelectionChanged"><ComboBoxItem Content="Contínua" Tag="solid"/><ComboBoxItem Content="Tracejada" Tag="dashed"/></ComboBox></StackPanel>
                                    <StackPanel x:Name="BlockGradientPanel" Grid.Row="5" Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Gradiente da camada" Foreground="{StaticResource MutedBrush}" /><ComboBox x:Name="BlockGradientBox" Height="34" SelectionChanged="AdvancedSelectionChanged"><ComboBoxItem Content="Sem gradiente" Tag=""/><ComboBoxItem Content="Da esquerda para a direita" Tag="to right"/><ComboBoxItem Content="De cima para baixo" Tag="to bottom"/><ComboBoxItem Content="Circular" Tag="circle"/></ComboBox></StackPanel>
                                    <StackPanel x:Name="TextStrokeWidthPanel" Grid.Row="6" Margin="0,7,5,7"><TextBlock Text="Contorno do texto (px)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="TextStrokeWidthBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                                    <StackPanel x:Name="TextStrokeColorPanel" Grid.Row="6" Grid.Column="1" Margin="5,7,0,7"><TextBlock Text="Cor do contorno" Foreground="{StaticResource MutedBrush}" /><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource EditorColorButton}" Content="…" ToolTip="Escolher cor" Tag="{Binding ElementName=TextStrokeColorBox}" IsEnabled="{Binding ElementName=TextStrokeColorBox, Path=IsEnabled}" Click="PickColorClicked" /><TextBox x:Name="TextStrokeColorBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></DockPanel></StackPanel>
                                    <StackPanel x:Name="TextShadowOffsetXPanel" Grid.Row="7" Margin="0,0,5,7"><TextBlock Text="Deslocamento da sombra X" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="TextShadowOffsetXBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                                    <StackPanel x:Name="TextShadowOffsetYPanel" Grid.Row="7" Grid.Column="1" Margin="5,0,0,7"><TextBlock Text="Deslocamento da sombra Y" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="TextShadowOffsetYBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                                    <StackPanel x:Name="TextShadowBlurPanel" Grid.Row="8" Margin="0,0,5,0"><TextBlock Text="Desfoque da sombra (px)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="TextShadowBlurBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                                    <StackPanel x:Name="TextShadowColorPanel" Grid.Row="8" Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Cor da sombra" Foreground="{StaticResource MutedBrush}" /><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource EditorColorButton}" Content="…" ToolTip="Escolher cor" Tag="{Binding ElementName=TextShadowColorBox}" IsEnabled="{Binding ElementName=TextShadowColorBox, Path=IsEnabled}" Click="PickColorClicked" /><TextBox x:Name="TextShadowColorBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></DockPanel></StackPanel>
                                </Grid>
                                <CheckBox x:Name="KeepRatioCheck" Content="Manter proporção ao redimensionar" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" Checked="AdvancedPropertyChanged" Unchecked="AdvancedPropertyChanged" />
                                <CheckBox x:Name="HideUnitCheck" Content="Ocultar unidade do indicador" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" Checked="AdvancedPropertyChanged" Unchecked="AdvancedPropertyChanged" />
                                <CheckBox x:Name="IsLyricCheck" Content="Exibir a letra atual da música" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" Checked="AdvancedPropertyChanged" Unchecked="AdvancedPropertyChanged" />
                                <CheckBox x:Name="ShowAreaCheck" Content="Preencher área do gráfico" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" Checked="AdvancedPropertyChanged" Unchecked="AdvancedPropertyChanged" />
                                <CheckBox x:Name="ShowXYCheck" Content="Exibir eixos e valores" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" Checked="AdvancedPropertyChanged" Unchecked="AdvancedPropertyChanged" />
                                <CheckBox x:Name="ShowSplitLinesCheck" Content="Exibir linhas de grade" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" Checked="AdvancedPropertyChanged" Unchecked="AdvancedPropertyChanged" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="SongDisplaySettingsPanel" Visibility="Collapsed" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="M&#205;DIA E LETRAS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Layout de m&#237;dia" Foreground="{StaticResource MutedBrush}" />
                                <ComboBox x:Name="SongPresetModeBox" Height="34" Margin="0,4,0,8" SelectionChanged="SongDisplaySettingsChanged">
                                    <ComboBoxItem Content="Horizontal - capa fixa" Tag="hFixed" />
                                    <ComboBoxItem Content="Horizontal - capa centralizada" Tag="hCenter" />
                                    <ComboBoxItem Content="Vertical - capa fixa" Tag="vFixed" />
                                    <ComboBoxItem Content="Vertical - capa centralizada" Tag="vCenter" />
                                    <ComboBoxItem Content="Somente capa" Tag="coverOnly" />
                                    <ComboBoxItem Content="Somente letras" Tag="lyricOnly" />
                                </ComboBox>
                                <WrapPanel>
                                    <CheckBox x:Name="SongShowCoverCheck" Content="Exibir capa" Foreground="{StaticResource TextBrush}" Margin="0,0,14,7" Checked="SongDisplaySettingsChanged" Unchecked="SongDisplaySettingsChanged" />
                                    <CheckBox x:Name="SongShowTitleCheck" Content="Exibir t&#237;tulo" Foreground="{StaticResource TextBrush}" Margin="0,0,14,7" Checked="SongDisplaySettingsChanged" Unchecked="SongDisplaySettingsChanged" />
                                    <CheckBox x:Name="SongShowArtistCheck" Content="Exibir artista" Foreground="{StaticResource TextBrush}" Margin="0,0,14,7" Checked="SongDisplaySettingsChanged" Unchecked="SongDisplaySettingsChanged" />
                                    <CheckBox x:Name="SongShowLyricsCheck" Content="Exibir letras" Foreground="{StaticResource TextBrush}" Margin="0,0,14,7" Checked="SongDisplaySettingsChanged" Unchecked="SongDisplaySettingsChanged" />
                                    <CheckBox x:Name="SongShowBackgroundCheck" Content="Fundo do cart&#227;o" Foreground="{StaticResource TextBrush}" Margin="0,0,14,7" Checked="SongDisplaySettingsChanged" Unchecked="SongDisplaySettingsChanged" />
                                    <CheckBox x:Name="SongShowHintCheck" Content="Mostrar dica sem m&#237;dia/letras" Foreground="{StaticResource TextBrush}" Margin="0,0,0,7" Checked="SongDisplaySettingsChanged" Unchecked="SongDisplaySettingsChanged" />
                                    <CheckBox x:Name="SongCircularCoverCheck" Content="Capa circular" Foreground="{StaticResource TextBrush}" Margin="0,0,14,7" Checked="SongDisplaySettingsChanged" Unchecked="SongDisplaySettingsChanged" />
                                    <CheckBox x:Name="SongRotateCoverCheck" Content="Girar capa" Foreground="{StaticResource TextBrush}" Margin="0,0,14,7" Checked="SongDisplaySettingsChanged" Unchecked="SongDisplaySettingsChanged" />
                                    <CheckBox x:Name="SongLyricScrollCheck" Content="Rolar letras sincronizadas" Foreground="{StaticResource TextBrush}" Margin="0,0,0,7" Checked="SongDisplaySettingsChanged" Unchecked="SongDisplaySettingsChanged" />
                                </WrapPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,5,6"><TextBlock Text="Tamanho da letra ativa (8-999 px)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="SongActiveFontSizeBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" LostKeyboardFocus="SongDisplayNumberLostFocus" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,6"><TextBlock Text="Quantidade de linhas (1-99)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="SongMaxLinesBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" LostKeyboardFocus="SongDisplayNumberLostFocus" /></StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,0,5,0"><TextBlock Text="Tamanho do t&#237;tulo (8-999 px)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="SongTitleFontSizeBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" LostKeyboardFocus="SongDisplayNumberLostFocus" /></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Tamanho do artista (8-999 px)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="SongArtistFontSizeBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" LostKeyboardFocus="SongDisplayNumberLostFocus" /></StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,6,5,0"><TextBlock Text="Raio do fundo (0-240 px)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="SongBackgroundRadiusBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" LostKeyboardFocus="SongDisplayNumberLostFocus" /></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="5,6,0,0"><TextBlock Text="Espa&#231;o entre linhas" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="SongLineSpacingBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                                    <StackPanel Grid.Row="3" Margin="0,6,5,0"><TextBlock Text="Cor do t&#237;tulo" Foreground="{StaticResource MutedBrush}" /><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource EditorColorButton}" Content="…" ToolTip="Escolher cor" Tag="{Binding ElementName=SongTitleColorBox}" IsEnabled="{Binding ElementName=SongTitleColorBox, Path=IsEnabled}" Click="PickColorClicked" /><TextBox x:Name="SongTitleColorBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></DockPanel></StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="5,6,0,0"><TextBlock Text="Opacidade do fundo (0-1)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="SongBackgroundOpacityBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" LostKeyboardFocus="SongDisplayNumberLostFocus" /></StackPanel>
                                    <StackPanel Grid.Row="4" Margin="0,6,5,0"><TextBlock Text="Preenchimento da capa" Foreground="{StaticResource MutedBrush}" /><ComboBox x:Name="SongCoverFillBox" Height="34" Margin="0,4,0,0" SelectionChanged="SongDisplaySettingsChanged"><ComboBoxItem Content="Autom&#225;tico / conter" Tag="auto" /><ComboBoxItem Content="Preencher altura" Tag="height" /><ComboBoxItem Content="Preencher largura" Tag="width" /></ComboBox></StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="5,6,0,0"><TextBlock Text="Dura&#231;&#227;o da rota&#231;&#227;o (s)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="SongCoverRotateDurationBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                                    <StackPanel Grid.Row="5" Margin="0,6,5,0"><TextBlock Text="Espa&#231;o entre capa e conte&#250;do" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="SongGapBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                                </Grid>
                                <TextBlock Text="As letras sincronizadas acompanham a posi&#231;&#227;o da faixa; sem correspond&#234;ncia, t&#237;tulo, artista e capa continuam dispon&#237;veis." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="AudioWaveSettingsPanel" Visibility="Collapsed" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ESPECTRO DE ÁUDIO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,5,6"><TextBlock Text="Quantidade de barras (20–256)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="AudioLineCountBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,6"><TextBlock Text="Espaçamento (0–5)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="AudioMarginBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,0,5,0"><TextBlock Text="Velocidade de queda (3–18)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="AudioReduceSpeedBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></StackPanel>
                                    <CheckBox x:Name="ArrangeAudioPeakCheck" Grid.Row="1" Grid.Column="1" Content="Pico no centro" Foreground="{StaticResource TextBrush}" Margin="5,8,0,0" Checked="AdvancedPropertyChanged" Unchecked="AdvancedPropertyChanged" />
                                </Grid>
                                <TextBlock Text="O espectro captura o áudio reproduzido pelo Windows. Sem áudio ativo, as barras ficam vazias." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="MediaSettingsPanel" Visibility="Collapsed" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="FONTE DA MÍDIA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Carregamento" Foreground="{StaticResource MutedBrush}" />
                                <ComboBox x:Name="MediaSourceModeBox" Height="34" Margin="0,4,0,8" SelectionChanged="MediaSourceModeChanged">
                                    <ComboBoxItem Content="Arquivo no tema" Tag="local" />
                                    <ComboBoxItem Content="URL da internet" Tag="online" />
                                </ComboBox>
                                <TextBlock Text="URL HTTP ou HTTPS" Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="MediaUrlBox" Style="{StaticResource EditorTextBox}" Margin="0,4,0,0" TextChanged="LayerPropertyChanged" />
                                <TextBlock Text="Mídia online é baixada em segundo plano e limitada a 90 MB." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ColorLabel" Text="Cor (ex.: #FFFFFF)" Foreground="{StaticResource MutedBrush}" />
                        <DockPanel x:Name="PrimaryColorInputPanel" Margin="0,4,0,12"><Button DockPanel.Dock="Right" Style="{StaticResource EditorColorButton}" Content="…" ToolTip="Escolher cor" Tag="{Binding ElementName=ColorBox}" IsEnabled="{Binding ElementName=ColorBox, Path=IsEnabled}" Click="PickColorClicked" /><TextBox x:Name="ColorBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></DockPanel>
                        <TextBlock x:Name="SecondColorLabel" Text="Segunda cor do gradiente" Foreground="{StaticResource MutedBrush}" />
                        <DockPanel x:Name="SecondColorInputPanel" Margin="0,4,0,12"><Button DockPanel.Dock="Right" Style="{StaticResource EditorColorButton}" Content="…" ToolTip="Escolher cor" Tag="{Binding ElementName=SecondColorBox}" IsEnabled="{Binding ElementName=SecondColorBox, Path=IsEnabled}" Click="PickColorClicked" /><TextBox x:Name="SecondColorBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></DockPanel>
                        <TextBlock x:Name="OutlineColorLabel" Text="Cor do contorno" Foreground="{StaticResource MutedBrush}" />
                        <DockPanel x:Name="OutlineColorInputPanel" Margin="0,4,0,12"><Button DockPanel.Dock="Right" Style="{StaticResource EditorColorButton}" Content="…" ToolTip="Escolher cor" Tag="{Binding ElementName=OutlineColorBox}" IsEnabled="{Binding ElementName=OutlineColorBox, Path=IsEnabled}" Click="PickColorClicked" /><TextBox x:Name="OutlineColorBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></DockPanel>
                        <TextBlock x:Name="TrackColorLabel" Text="Cor do trilho / fundo do gráfico" Foreground="{StaticResource MutedBrush}" />
                        <DockPanel x:Name="TrackColorInputPanel" Margin="0,4,0,12"><Button DockPanel.Dock="Right" Style="{StaticResource EditorColorButton}" Content="…" ToolTip="Escolher cor" Tag="{Binding ElementName=TrackColorBox}" IsEnabled="{Binding ElementName=TrackColorBox, Path=IsEnabled}" Click="PickColorClicked" /><TextBox x:Name="TrackColorBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" /></DockPanel>
                        <TextBlock x:Name="FontFamilyLabel" Text="Família da fonte" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox x:Name="FontFamilyBox" Height="34" Margin="0,4,0,8" IsEditable="True" IsTextSearchEnabled="False" Loaded="ClockFormatBoxLoaded" SelectionChanged="AdvancedSelectionChanged" />
                        <CheckBox x:Name="BoldCheck" Content="Negrito" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" Checked="LayerFormattingChanged" Unchecked="LayerFormattingChanged" />
                        <CheckBox x:Name="ItalicCheck" Content="Itálico" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" Checked="LayerFormattingChanged" Unchecked="LayerFormattingChanged" />
                        <CheckBox x:Name="UnderlineCheck" Content="Sublinhado" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" Checked="LayerFormattingChanged" Unchecked="LayerFormattingChanged" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel x:Name="FontSizePanel" Margin="0,0,5,0"><TextBlock x:Name="FontSizeLabel" Text="Fonte (px)" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="FontSizeBox" Style="{StaticResource EditorTextBox}" TextChanged="LayerPropertyChanged" LostKeyboardFocus="SongDisplayNumberLostFocus" /></StackPanel>
                            <StackPanel x:Name="TextAlignmentPanel" Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Alinhamento" Foreground="{StaticResource MutedBrush}" /><ComboBox x:Name="AlignBox" Height="34" Margin="0,4,0,0" SelectionChanged="AlignChanged"><ComboBoxItem Content="Esquerda" Tag="left"/><ComboBoxItem Content="Centro" Tag="center"/><ComboBoxItem Content="Direita" Tag="right"/></ComboBox></StackPanel>
                        </Grid>
                        <TextBlock x:Name="GeneralColorHelpText" Text="A cor aceita #RRGGBB ou R,G,B,A. A fonte precisa existir no Windows." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Prévia ao vivo usando os sensores disponíveis neste PC." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancelar" Style="{StaticResource EditorButton}" Margin="0,0,8,0" Click="CancelClicked" />
                <Button x:Name="SaveEditorButton" Content="Salvar pacote .ht" Style="{StaticResource Win11PrimaryButton}" Click="SaveClicked" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
